#!/usr/bin/env bash
#
# dash-activate — Activate Realtek RealManage (DMTF DASH) from Linux
#
# Replaces the Windows-only DASHConfigRT provisioning tool.
# Configures DASH credentials and network via the driver ioctl interface.
#
set -euo pipefail

VERSION="0.1.0"
RTDASH_CTL=""  # path to rtdash-ctl binary (built from librtdash)

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log()  { echo -e "${GREEN}[+]${NC} $*"; }
warn() { echo -e "${YELLOW}[!]${NC} $*"; }
err()  { echo -e "${RED}[-]${NC} $*" >&2; }
die()  { err "$@"; exit 1; }

usage() {
    cat <<'EOF'
dash-activate — Activate Realtek RealManage (DMTF DASH) from Linux

USAGE:
    sudo dash-activate [OPTIONS]

OPTIONS:
    -i <interface>     Network interface (auto-detect if omitted)
    -u <username>      Admin username (default: Administrator)
    -p <password>      Admin password (auto-generated if omitted)
    -4 <ip/mask/gw>    OOB IPv4 config (e.g., 192.168.1.50/255.255.255.0/192.168.1.1)
    -d                 Use DHCP for OOB network
    -S                 Provision TLS/HTTPS self-signed certificate
    -V                 Verify activation via realmanage CLI after setup
    -R                 Reset DASH credentials back to factory defaults
    -Q <ip>            Probe DASH status on a given IP without making changes
    -n                 Dry run (show what would be done)
    -h                 Show help

PREREQUISITES:
    - DASH-capable Realtek NIC (RTL8111DP/EP/FP, RTL8125BP, RTL8126, RTL8127AP)
    - DASH enabled in BIOS (Advanced > Network > RealManage Firmware Control)
    - Realtek out-of-tree driver loaded (r8125/r8126/r8127 with DASH support)
    - Root privileges

NOTES:
    Unlike Intel AMT, Realtek DASH cannot be activated without first enabling
    it in the BIOS. This tool handles the post-BIOS credential and network
    configuration that DASHConfigRT does on Windows.

    After activation, manage the system remotely with:
        realmanage -t <oob-ip> info
        realmanage -t <oob-ip> power status

HARDWARE COMPATIBILITY:
    Confirmed working:
    - RTL8111EP on Gigabyte B550M (DASH 2.0.18)
    - RTL8111FP on HP EliteDesk 805 G8 (DASH via AMD PRO)
    - RTL8125BP on AMD Ryzen PRO 6000+ platforms

    Should work (untested):
    - RTL8111DP (original DASH chip, 2009+)
    - RTL8126 (5GbE DASH)
    - RTL8127AP (10GbE DASH)

    Does NOT work (no DASH hardware):
    - RTL8111B/C/D/E/F/G/H/K/L (consumer, no management engine)
    - RTL8125B (consumer 2.5GbE, no DASH)
EOF
}

gen_password() {
    python3 -c "import secrets; print(secrets.token_urlsafe(20)[:16])" 2>/dev/null || \
    tr -dc "A-Za-z0-9" </dev/urandom | head -c 16
}

detect_interface() {
    local iface
    for iface_path in /sys/class/net/*/; do
        iface=$(basename "$iface_path")
        [ "$iface" = "lo" ] && continue

        # check for Realtek DASH driver
        local driver=""
        if [ -L "/sys/class/net/$iface/device/driver" ]; then
            driver=$(basename "$(readlink "/sys/class/net/$iface/device/driver")")
        fi

        case "$driver" in
            r8125|r8126|r8127|r8168|r8169)
                # check if DASH-capable via vendor/device ID
                local vendor device
                vendor=$(cat "/sys/class/net/$iface/device/vendor" 2>/dev/null || echo "")
                device=$(cat "/sys/class/net/$iface/device/device" 2>/dev/null || echo "")

                if [ "$vendor" = "0x10ec" ]; then
                    log "Found Realtek NIC: $iface (driver=$driver, device=$device)"
                    echo "$iface"
                    return 0
                fi
                ;;
        esac
    done
    return 1
}

check_dash_bios() {
    local iface="$1"
    # attempt to probe via ioctl — if driver supports DASH and BIOS has it enabled,
    # the ioctl will succeed
    if [ -n "$RTDASH_CTL" ] && [ -x "$RTDASH_CTL" ]; then
        if "$RTDASH_CTL" -i "$iface" check 2>/dev/null; then
            return 0
        fi
    fi

    # fallback: check dmesg for DASH indicators
    if dmesg 2>/dev/null | grep -qi "dash\|realmanage\|oob.*ready"; then
        return 0
    fi

    return 1
}

check_default_creds() {
    local ip="$1"
    # try connecting with default Realtek credentials
    if command -v wsman >/dev/null 2>&1; then
        local xml
        xml=$(wsman enumerate "http://schemas.dmtf.org/wbem/wscim/1/cim-schema/2/CIM_ComputerSystem" \
            -h "$ip" -P 623 -u "Administrator" -p "Realtek" -y "http" \
            -O - 2>/dev/null) || return 1
        echo "$xml" | grep -q "ComputerSystem" && return 0
    fi

    # try curl to embedded web server
    if curl -s --connect-timeout 3 "http://${ip}:623" 2>/dev/null | grep -qi "realtek\|dash"; then
        return 0
    fi

    return 1
}

configure_via_wsman() {
    local ip="$1" user="$2" pass="$3" old_user="Administrator" old_pass="Realtek"
    local cim="http://schemas.dmtf.org/wbem/wscim/1/cim-schema/2"

    log "Changing default credentials via WS-Man..."

    # change password on default Administrator account
    if [ "$old_pass" != "$pass" ]; then
        wsman invoke -a "SetPassword" "${cim}/CIM_Account" \
            -h "$ip" -P 623 -u "$old_user" -p "$old_pass" -y "http" \
            -k "UserID=$old_user" \
            -k "UserPassword=$pass" \
            -O - 2>/dev/null || warn "Password change via WS-Man failed (may need DASHConfigRT path)"
    fi

    log "Credentials configured"
}

provision_https_cert() {
    local oob_ip="${1:-}"
    command -v openssl >/dev/null 2>&1 || die "openssl is required for TLS certificate provisioning"

    local CERT_DIR=/etc/rtdash-certs
    mkdir -p "$CERT_DIR"

    log "Generating self-signed TLS certificate..."
    openssl req -x509 -newkey rsa:2048 \
        -keyout "$CERT_DIR/dash-key.pem" \
        -out "$CERT_DIR/dash-cert.pem" \
        -days 3650 -nodes \
        -subj "/CN=DASH-OOB/O=RealManage" 2>/dev/null

    chmod 600 "$CERT_DIR/dash-key.pem"
    log "Certificate written to $CERT_DIR/dash-cert.pem"
    log "Private key written to $CERT_DIR/dash-key.pem"

    echo ""
    log "Certificate fingerprint:"
    openssl x509 -in "$CERT_DIR/dash-cert.pem" -fingerprint -sha256 -noout
    echo ""
    echo "  To trust this certificate in browsers:"
    echo "    Chrome:  Settings > Privacy > Security > Manage Certificates > Import"
    echo "    Firefox: Settings > Privacy > View Certificates > Import"
    echo "    Edge:    Settings > Privacy > Manage Certificates > Import"
    echo "    System:  sudo cp $CERT_DIR/dash-cert.pem /usr/local/share/ca-certificates/dash-oob.crt && sudo update-ca-certificates"
    echo ""

    # attempt to push cert to BMC via WS-Man
    if [ -n "$oob_ip" ] && command -v wsman >/dev/null 2>&1; then
        log "Attempting to push certificate to BMC via WS-Man..."
        local cim="http://schemas.dmtf.org/wbem/wscim/1/cim-schema/2"
        local cert_b64
        cert_b64=$(base64 -w0 "$CERT_DIR/dash-cert.pem" 2>/dev/null || base64 "$CERT_DIR/dash-cert.pem" 2>/dev/null)
        wsman invoke -a "InstallFromByteStream" "${cim}/CIM_SoftwareInstallationService" \
            -h "$oob_ip" -P 623 -u "$USERNAME" -p "$PASSWORD" -y "http" \
            -k "Certificate=$cert_b64" \
            -O - 2>/dev/null && log "Certificate pushed to BMC" || warn "Certificate push via WS-Man failed (manual import may be required)"
    fi

    # test HTTPS connectivity
    if [ -n "$oob_ip" ]; then
        if curl -sk --connect-timeout 3 "https://${oob_ip}:664" >/dev/null 2>&1; then
            log "HTTPS working on port 664"
        fi
    fi
}

do_status_probe() {
    local probe_ip="$1"
    [ -z "$probe_ip" ] && die "-Q requires an IP address"

    echo -e "${BLUE}"
    echo "  DASH Status Probe: $probe_ip"
    echo -e "${NC}"

    # probe port 623 (HTTP/WS-Man)
    log "Probing port 623 (HTTP/WS-Man)..."
    if curl -s --connect-timeout 3 "http://${probe_ip}:623" >/dev/null 2>&1; then
        log "Port 623: OPEN"
    else
        warn "Port 623: CLOSED or unreachable"
    fi

    # probe port 664 (HTTPS)
    log "Probing port 664 (HTTPS)..."
    if curl -sk --connect-timeout 3 "https://${probe_ip}:664" >/dev/null 2>&1; then
        log "Port 664: OPEN (HTTPS)"
    else
        warn "Port 664: CLOSED or unreachable"
    fi

    # enumerate profiles via WS-Man
    if command -v wsman >/dev/null 2>&1; then
        log "Enumerating DASH profiles via WS-Man..."
        local cim="http://schemas.dmtf.org/wbem/wscim/1/cim-schema/2"
        local xml
        xml=$(wsman enumerate "${cim}/CIM_RegisteredProfile" \
            -h "$probe_ip" -P 623 -u "Administrator" -p "Realtek" -y "http" \
            -O - 2>&1) || true
        if echo "$xml" | grep -qi "RegisteredProfile\|DASH"; then
            log "DASH profiles found:"
            echo "$xml" | grep -i "RegisteredName\|RegisteredVersion" | sed 's/^/    /'
        else
            warn "Could not enumerate profiles (credentials may differ from defaults)"
        fi
    else
        warn "wsman not installed — skipping profile enumeration"
    fi

    # try realmanage if available
    if command -v realmanage >/dev/null 2>&1; then
        log "Querying via realmanage..."
        realmanage -t "$probe_ip" -u "Administrator" -P "Realtek" profiles 2>/dev/null && \
            log "DASH is ACTIVE with default credentials" || \
            warn "realmanage query failed (DASH may be inactive or credentials changed)"
    fi

    echo ""
    log "Probe complete"
}

do_reset_defaults() {
    local reset_ip="${OOB_IP:-}"
    [ -z "$reset_ip" ] && die "OOB IP required for reset (-4 or auto-detected)"

    echo -e "${YELLOW}"
    echo "  WARNING: This will reset DASH credentials to factory defaults"
    echo "  (Administrator / Realtek)"
    echo -e "${NC}"

    local current_pass
    read -rsp "Enter current DASH password: " current_pass
    echo ""
    [ -z "$current_pass" ] && die "Password cannot be empty"

    local cim="http://schemas.dmtf.org/wbem/wscim/1/cim-schema/2"
    log "Resetting password to factory default via WS-Man..."
    wsman invoke -a "SetPassword" "${cim}/CIM_Account" \
        -h "$reset_ip" -P 623 -u "$USERNAME" -p "$current_pass" -y "http" \
        -k "UserID=$USERNAME" \
        -k "UserPassword=Realtek" \
        -O - 2>/dev/null && log "Password reset to factory default (Realtek)" || \
        die "Password reset failed — check current credentials and connectivity"
}

do_verify() {
    local verify_ip="${OOB_IP:-}"
    [ -z "$verify_ip" ] && { warn "No OOB IP — skipping verification"; return 0; }

    log "Verifying activation..."
    if command -v realmanage >/dev/null 2>&1; then
        realmanage -t "$verify_ip" -u "$USERNAME" -P "$PASSWORD" profiles 2>/dev/null && \
            log "Verification PASSED" || warn "Verification FAILED"
    else
        warn "realmanage not found — skipping verification"
    fi
}

# --- Main ---

[ "$(id -u)" -ne 0 ] && die "must run as root"

IFACE=""
USERNAME="Administrator"
PASSWORD=""
IPV4_CONFIG=""
USE_DHCP=0
DRY_RUN=0
DO_TLS=0
DO_VERIFY=0
DO_RESET=0
PROBE_IP=""

while getopts "i:u:p:4:dSVRQ:nh" opt; do
    case "$opt" in
        i) IFACE="$OPTARG" ;;
        u) USERNAME="$OPTARG" ;;
        p) PASSWORD="$OPTARG" ;;
        4) IPV4_CONFIG="$OPTARG" ;;
        d) USE_DHCP=1 ;;
        S) DO_TLS=1 ;;
        V) DO_VERIFY=1 ;;
        R) DO_RESET=1 ;;
        Q) PROBE_IP="$OPTARG" ;;
        n) DRY_RUN=1 ;;
        h) usage; exit 0 ;;
        *) usage; exit 1 ;;
    esac
done

# Handle status probe mode (standalone, no activation)
if [ -n "$PROBE_IP" ]; then
    do_status_probe "$PROBE_IP"
    exit 0
fi

echo -e "${BLUE}"
echo "  ╔══════════════════════════════════════════════╗"
echo "  ║  dash-activate v${VERSION}                        ║"
echo "  ║  Realtek RealManage (DMTF DASH) Provisioning ║"
echo "  ╚══════════════════════════════════════════════╝"
echo -e "${NC}"

# locate rtdash-ctl
for candidate in ./rtdash-ctl /usr/bin/rtdash-ctl /usr/local/bin/rtdash-ctl; do
    [ -x "$candidate" ] && RTDASH_CTL="$candidate" && break
done

# Handle reset mode
if [ "$DO_RESET" -eq 1 ]; then
    # still need OOB_IP for reset
    OOB_IP=""
    if [ -n "$IPV4_CONFIG" ]; then
        OOB_IP="${IPV4_CONFIG%%/*}"
    elif [ -n "$RTDASH_CTL" ] && [ -n "$IFACE" ]; then
        OOB_IP=$("$RTDASH_CTL" -i "$IFACE" get-ipv4 2>/dev/null | awk '{print $1}') || true
    fi
    do_reset_defaults
    exit 0
fi

# Step 1: Find interface
if [ -z "$IFACE" ]; then
    log "Auto-detecting DASH-capable interface..."
    IFACE=$(detect_interface) || die "No Realtek DASH NIC found. Check: lspci | grep -i realtek"
fi
log "Interface: $IFACE"

# Step 2: Verify DASH is enabled in BIOS
log "Checking DASH firmware status..."
if ! check_dash_bios "$IFACE"; then
    warn "DASH may not be enabled in BIOS"
    echo ""
    echo "  To enable DASH in BIOS:"
    echo "  1. Reboot and enter BIOS Setup"
    echo "  2. Navigate to: Advanced > Network Controller / Realtek LAN"
    echo "  3. Enable: RealManage Firmware Control"
    echo "  4. Enable: DASH Support"
    echo "  5. (Optional) Enable: MCTP, ASF, Serial Port Console Redirection"
    echo "  6. Save and exit"
    echo ""
    echo "  Vendor-specific paths:"
    echo "  - Gigabyte: Peripherals > Realtek PCIe GBE Family Controller"
    echo "  - HP:       Advanced > Built-In Device Options > LAN DASH Support"
    echo "  - Lenovo:   Advanced > Network Setup > DASH Configuration"
    echo "  - Dell:     System Configuration > NIC Configuration > DASH Support"
    echo "  - ASUS:     Advanced > Onboard Devices Configuration > Realtek LAN Controller DASH"
    echo "  - MSI:      Settings > Advanced > Integrated Peripherals > Realtek DASH Support"
    echo "  - ASRock:   Advanced > Onboard Devices Configuration > Realtek LAN DASH"
    echo ""
    read -rp "Continue anyway? [y/N] " yn
    [ "$yn" = "y" ] || [ "$yn" = "Y" ] || exit 1
fi

# Step 3: Generate password if not provided
if [ -z "$PASSWORD" ]; then
    PASSWORD=$(gen_password)
    log "Generated password: $PASSWORD"
    warn "SAVE THIS PASSWORD — you need it for remote management"
fi

# Step 4: Show plan
echo ""
echo "  Configuration:"
echo "    Interface:  $IFACE"
echo "    Username:   $USERNAME"
echo "    Password:   $PASSWORD"
if [ -n "$IPV4_CONFIG" ]; then
    echo "    OOB IPv4:   $IPV4_CONFIG"
elif [ "$USE_DHCP" -eq 1 ]; then
    echo "    OOB Network: DHCP"
else
    echo "    OOB Network: (keep current)"
fi
[ "$DO_TLS" -eq 1 ] && echo "    TLS/HTTPS:  will provision self-signed certificate"
[ "$DO_VERIFY" -eq 1 ] && echo "    Verify:     will verify after activation"
echo ""

if [ "$DRY_RUN" -eq 1 ]; then
    log "Dry run — no changes made"
    exit 0
fi

read -rp "Proceed with activation? [y/N] " yn
[ "$yn" = "y" ] || [ "$yn" = "Y" ] || exit 1

# Step 5: Configure OOB network if requested
if [ -n "$IPV4_CONFIG" ] && [ -n "$RTDASH_CTL" ]; then
    IFS='/' read -r oob_ip oob_mask oob_gw <<< "$IPV4_CONFIG"
    log "Setting OOB IPv4: $oob_ip / $oob_mask / $oob_gw"
    "$RTDASH_CTL" -i "$IFACE" set-ipv4 "$oob_ip" "$oob_mask" "$oob_gw" || warn "set-ipv4 failed"
fi

# Step 6: Try to change credentials
# First, try WS-Man path (works if DASH is already listening on default creds)
OOB_IP=""
if [ -n "$IPV4_CONFIG" ]; then
    OOB_IP="${IPV4_CONFIG%%/*}"
elif [ -n "$RTDASH_CTL" ]; then
    OOB_IP=$("$RTDASH_CTL" -i "$IFACE" get-ipv4 2>/dev/null | awk '{print $1}') || true
fi

if [ -n "$OOB_IP" ]; then
    log "Checking if DASH is reachable at $OOB_IP:623..."
    if check_default_creds "$OOB_IP"; then
        log "DASH responding with default credentials — changing now"
        configure_via_wsman "$OOB_IP" "$USERNAME" "$PASSWORD"
    else
        warn "Cannot reach DASH at $OOB_IP:623 with default credentials"
        warn "Credentials may already be changed, or DASH not yet initialized"
    fi
else
    warn "No OOB IP known — skipping credential configuration"
    warn "Use the BIOS RealManage Setup Agent (Shift+F10 at POST) to set initial credentials"
fi

# Step 7: Send driver ready + sync hostname via ioctl
if [ -n "$RTDASH_CTL" ]; then
    log "Sending DRIVER_READY signal..."
    "$RTDASH_CTL" -i "$IFACE" driver-ready || warn "driver-ready failed"

    log "Syncing hostname..."
    "$RTDASH_CTL" -i "$IFACE" sync-hostname || warn "sync-hostname failed"
fi

# Step 8: Provision HTTPS certificate if requested
if [ "$DO_TLS" -eq 1 ]; then
    provision_https_cert "$OOB_IP"
fi

# Step 9: Verify activation if requested
if [ "$DO_VERIFY" -eq 1 ]; then
    do_verify
fi

# Step 10: Summary
echo ""
log "Activation complete!"
echo ""
echo "  Next steps:"
echo "    1. Verify: realmanage -t $OOB_IP -u $USERNAME -P '$PASSWORD' info"
echo "    2. Web UI: http://$OOB_IP:623"
echo "    3. Power:  realmanage -t $OOB_IP -u $USERNAME -P '$PASSWORD' power status"
echo "    4. Enable rtdashd service: sudo systemctl enable --now rtdashd"
echo ""

if [ -n "$RTDASH_CTL" ]; then
    echo "  Start the DASH client daemon for OS info push + graceful shutdown:"
    echo "    sudo systemctl enable --now rtdashd"
fi
